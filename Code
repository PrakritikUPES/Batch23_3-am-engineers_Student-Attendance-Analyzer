#include <stdio.h>
#include <string.h>
#include <ctype.h>
#include <stdlib.h>

struct Student {
    int roll;
    char name[50];
    int total_classes;
    int attended_classes;
    float percentage;
    char status[15];
};

int isValidNumber(char str[]) {
    int len = strlen(str);
    if (len == 0) return 0;
    for (int i = 0; i < len; i++) {
        if (!isdigit((unsigned char)str[i])) {
            return 0;
        }
    }
    return 1;
}

int isValidName(char str[]) {
    int len = strlen(str);
    int hasLetter = 0;
    if (len == 0) return 0;
    for (int i = 0; i < len; i++) {
        if (isalpha((unsigned char)str[i])) {
            hasLetter = 1;
        } else if (str[i] != ' ') {
            return 0;
        }
    }
    return hasLetter;
}

void saveToFile(struct Student students[], int count) {
    FILE *fp = fopen("attendance.txt", "w");
    if (fp != NULL) {
        fprintf(fp, "%-10s %-24s\t%-10s %-10s %-12s %-10s\n", "Roll_No", "Name", "Total", "Attended", "Attendance", "Status");
        fprintf(fp, "--------------------------------------------------------------------------------\n");
        for (int i = 0; i < count; i++) {
            fprintf(fp, "%-10d %-24s\t%-10d %-10d %-11.2f%% %-10s\n",
                    students[i].roll,
                    students[i].name,
                    students[i].total_classes,
                    students[i].attended_classes,
                    students[i].percentage,
                    students[i].status);
        }
        fclose(fp);
    } else {
        printf("Error saving to file.\n");
    }
}

int main() {
    struct Student students[100];
    int count = 0;
    int initial_total_classes = 0;
    int choice;
    char input[100];

    FILE *fp = fopen("attendance.txt", "r");
    if (fp != NULL) {
        char line[256];
        fgets(line, sizeof(line), fp);
        fgets(line, sizeof(line), fp);
        while (fgets(line, sizeof(line), fp) != NULL) {
            if (sscanf(line, "%d %49[^\t] %d %d %f%% %14s",
                       &students[count].roll,
                       students[count].name,
                       &students[count].total_classes,
                       &students[count].attended_classes,
                       &students[count].percentage,
                       students[count].status) == 6) {
                int len = strlen(students[count].name);
                while (len > 0 && students[count].name[len - 1] == ' ') {
                    students[count].name[--len] = '\0';
                }
                count++;
            }
        }
        fclose(fp);
    }

    if (count > 0) {
        initial_total_classes = students[0].total_classes;
        printf("Loaded %d existing records (Total Classes Held: %d).\n", count, initial_total_classes);
    } else {
        while (1) {
            printf("Enter Total Classes Held: ");
            scanf(" %99[^\n]", input);
            if (isValidNumber(input) && atoi(input) > 0) {
                initial_total_classes = atoi(input);
                break;
            }
            printf("Error: Total classes must contain only digits and be greater than 0.\n");
        }
    }

    while (1) {
        printf("\n1. Add Student Attendance\n");
        printf("2. View All Records\n");
        printf("3. Edit Student Details\n");
        printf("4. Exit\n");
        printf("Enter choice: ");
        scanf(" %99[^\n]", input);

        if (!isValidNumber(input)) {
            printf("Error: Choice must be a valid number.\n");
            continue;
        }
        choice = atoi(input);

        if (choice == 1) {
            if (count >= 100) {
                printf("Database full.\n");
                continue;
            }

            while (1) {
                printf("Enter Roll Number: ");
                scanf(" %99[^\n]", input);
                if (isValidNumber(input)) {
                    students[count].roll = atoi(input);
                    break;
                }
                printf("Error: Roll number must contain only digits (no alphabets or symbols).\n");
            }

            while (1) {
                printf("Enter Full Name: ");
                scanf(" %49[^\n]", students[count].name);
                if (isValidName(students[count].name)) {
                    break;
                }
                printf("Error: Name must contain only alphabets and spaces (no numbers or symbols).\n");
            }

            students[count].total_classes = initial_total_classes;

            while (1) {
                printf("Enter Classes Attended (out of %d): ", initial_total_classes);
                scanf(" %99[^\n]", input);
                if (!isValidNumber(input)) {
                    printf("Error: Classes attended must contain only digits (no alphabets or symbols).\n");
                    continue;
                }
                int att = atoi(input);
                if (att > initial_total_classes) {
                    printf("Error: Classes attended cannot exceed Total Classes Held (%d).\n", initial_total_classes);
                    continue;
                }
                students[count].attended_classes = att;
                break;
            }

            students[count].percentage = ((float)students[count].attended_classes / students[count].total_classes) * 100.0f;

            if (students[count].percentage >= 75.0f) {
                strcpy(students[count].status, "Eligible");
            } else {
                strcpy(students[count].status, "Short");
            }

            count++;
            saveToFile(students, count);
            printf("Saved! %s: %.2f%% (%s)\n", students[count - 1].name, students[count - 1].percentage, students[count - 1].status);
        } 
        else if (choice == 2) {
            if (count == 0) {
                printf("No records found.\n");
            } else {
                printf("\n%-10s %-24s %-10s %-10s %-12s %-10s\n", "Roll_No", "Name", "Total", "Attended", "Attendance", "Status");
                printf("--------------------------------------------------------------------------------\n");
                for (int i = 0; i < count; i++) {
                    printf("%-10d %-24s %-10d %-10d %-11.2f%% %-10s\n",
                           students[i].roll,
                           students[i].name,
                           students[i].total_classes,
                           students[i].attended_classes,
                           students[i].percentage,
                           students[i].status);
                }
            }
        } 
        else if (choice == 3) {
            if (count == 0) {
                printf("No records available to edit.\n");
                continue;
            }

            int target_roll;
            while (1) {
                printf("Enter Roll Number to edit: ");
                scanf(" %99[^\n]", input);
                if (isValidNumber(input)) {
                    target_roll = atoi(input);
                    break;
                }
                printf("Error: Roll number must contain only digits.\n");
            }

            int found_idx = -1;
            for (int i = 0; i < count; i++) {
                if (students[i].roll == target_roll) {
                    found_idx = i;
                    break;
                }
            }

            if (found_idx == -1) {
                printf("Student with Roll Number %d not found.\n", target_roll);
                continue;
            }

            printf("\nCurrent Details -> Name: %s | Attended: %d/%d | Attendance: %.2f%% (%s)\n",
                   students[found_idx].name,
                   students[found_idx].attended_classes,
                   students[found_idx].total_classes,
                   students[found_idx].percentage,
                   students[found_idx].status);

            int edit_choice;
            while (1) {
                printf("What would you like to edit?\n");
                printf("1. Edit Name\n");
                printf("2. Edit Classes Attended\n");
                printf("3. Edit Both\n");
                printf("Enter choice: ");
                scanf(" %99[^\n]", input);
                if (isValidNumber(input)) {
                    edit_choice = atoi(input);
                    if (edit_choice >= 1 && edit_choice <= 3) break;
                }
                printf("Error: Please enter 1, 2, or 3.\n");
            }

            if (edit_choice == 1 || edit_choice == 3) {
                while (1) {
                    printf("Enter New Full Name: ");
                    scanf(" %49[^\n]", students[found_idx].name);
                    if (isValidName(students[found_idx].name)) {
                        break;
                    }
                    printf("Error: Name must contain only alphabets and spaces.\n");
                }
            }

            if (edit_choice == 2 || edit_choice == 3) {
                while (1) {
                    printf("Enter New Classes Attended (out of %d): ", students[found_idx].total_classes);
                    scanf(" %99[^\n]", input);
                    if (!isValidNumber(input)) {
                        printf("Error: Classes attended must contain only digits.\n");
                        continue;
                    }
                    int att = atoi(input);
                    if (att > students[found_idx].total_classes) {
                        printf("Error: Classes attended cannot exceed Total Classes Held (%d).\n", students[found_idx].total_classes);
                        continue;
                    }
                    students[found_idx].attended_classes = att;
                    break;
                }
            }

            students[found_idx].percentage = ((float)students[found_idx].attended_classes / students[found_idx].total_classes) * 100.0f;
            if (students[found_idx].percentage >= 75.0f) {
                strcpy(students[found_idx].status, "Eligible");
            } else {
                strcpy(students[found_idx].status, "Short");
            }

            saveToFile(students, count);
            printf("Updated! %s: %.2f%% (%s)\n", students[found_idx].name, students[found_idx].percentage, students[found_idx].status);
        }
        else if (choice == 4) {
            break;
        } 
        else {
            printf("Invalid choice.\n");
        }
    }

    return 0;
}
